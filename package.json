{
  "name": "react-dom-outside",
  "version": "1.0.16",
  "description": "React components for react-dom and react-native-web click outside",
  "keywords": [
    "react",
    "web",
    "react-dom",
    "dom",
    "contains",
    "outside",
    "universal",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kmalakoff/react-dom-outside.git"
  },
  "license": "MIT",
  "author": "Kevin Malakoff <kmalakoff@gmail.com> (https://github.com/kmalakoff)",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json",
    "./umd": "./dist/umd/react-dom-outside.cjs"
  },
  "main": "dist/cjs/index.js",
  "source": "src/index.ts",
  "types": "dist/cjs/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsds build",
    "docs": "tsds docs",
    "format": "tsds format",
    "prepublishOnly": "tsds validate",
    "test": "npm run test:types && node test/lib/browser.mjs && npm run test:node",
    "test:browser:checkpoints": "node test/lib/browser-checkpoints.mjs",
    "test:engines": "npm run build && node test/lib/test-floor.ts",
    "test:node": "tsds test:node --no-timeouts test/exports/import.test.ts test/exports/import.test.mjs test/exports/require.test.cjs test/exports/umd.test.cjs",
    "test:types": "npm run build && node test/types/run.ts",
    "version": "tsds version"
  },
  "devDependencies": {
    "@types/mocha": "*",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@web/dev-server-import-maps": "^0.3.0",
    "assert": "^2.1.0",
    "esbuild": "^0.28.2",
    "fs-remove-compat": "^1.0.0",
    "node-version-use": "*",
    "react": "*",
    "react-dom": "*",
    "react-dom-event": "^1.0.10",
    "react-ref-boundary": "^1.0.9",
    "tar": "^7.5.22",
    "ts-dev-stack": "*",
    "tsds-config": "*",
    "tsds-web-test-runner": "*"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom-event": "^1.0.8",
    "react-ref-boundary": "^1.0.7"
  },
  "engines": {
    "node": ">=16"
  },
  "allowScripts": {
    "esbuild": true
  },
  "tsds": {
    "targets": [
      "cjs",
      "esm",
      "umd"
    ],
    "globals": {
      "react": "React",
      "react-dom-event": "reactDomEvent",
      "react-dom-contains": "reactDomContains",
      "react-ref-boundary": "ReactRefBoundary"
    }
  }
}
